# ---- Datasets and generated outputs ----
# Nothing under data/ is committed except the directory placeholders.
data/**
!data/**/
!data/**/.gitkeep

# Audit reports are statistics and metadata only -- never copied images or
# annotations -- so they are committed as a record of what we inspected.
!data/audits/**

# Review artefacts: the small records are committed, the contact sheets are
# not -- they embed absolute file:// paths to an external dataset and are
# meaningless on another machine. Everything else under data/review/ stays
# ignored via data/** above.
!data/review/*/review.csv
!data/review/*/statistics.txt

# ---- Collected dataset images ----
# The structure, meta.csv, the generator and the docs are committed.
# The image files themselves are not; they are rebuilt from meta.csv
# plus the source registry in docs/data_sources.md.
dataset/images/**
!dataset/images/**/
!dataset/images/**/.gitkeep

# Label files are derived from meta.csv and regenerated, never edited.
dataset/labels/*
!dataset/labels/.gitkeep

# ---- Downloaded external datasets (staging only, never committed) ----
# Third-party datasets are audited here before any human approval.
# They must never be unpacked into dataset/.
data/external/
reports/

# ---- Trained model weights ----
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.tflite
*.weights
*.ckpt
*.safetensors
*.h5
*.pb
*.engine
*.trt

# ---- Training / experiment artifacts ----
runs/
wandb/
mlruns/
lightning_logs/
*.log

